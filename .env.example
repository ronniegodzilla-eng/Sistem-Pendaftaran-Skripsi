# Salin file ini menjadi .env untuk pengembangan lokal, lalu isi nilainya.
# Di Vercel, isikan variabel yang sama lewat Settings > Environment Variables.
#
# PENTING: semua variabel berawalan VITE_ ditanam ke dalam bundle JavaScript
# saat build dan bisa dibaca siapa pun lewat DevTools. Variabel ini BUKAN
# tempat menyimpan rahasia. Yang mengamankan database adalah Firestore Rules.
#
# Setelah mengubah nilai apa pun di Vercel, aplikasi WAJIB di-redeploy —
# nilainya dibekukan saat build, bukan dibaca saat aplikasi berjalan.

# --- Wajib: tanpa ini, services/firebase.ts menonaktifkan Firestore dan
# --- aplikasi diam-diam berjalan hanya dengan localStorage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Sangat disarankan: site key reCAPTCHA v3 untuk Firebase App Check.
# --- Tanpa ini, App Check tidak aktif dan Firestore bisa diakses siapa pun
# --- yang punya projectId (yang memang publik). Site key ini aman untuk
# --- ditaruh di sisi klien; yang rahasia adalah secret key-nya, dan itu
# --- hanya ditempel sekali di Firebase Console, tidak pernah masuk ke kode.
VITE_RECAPTCHA_SITE_KEY=

# --- Opsional: URL Google Apps Script untuk unggah berkas ke Drive.
# --- Jika kosong, driveService.ts memakai nilai dari localStorage yang
# --- diatur melalui menu Admin Settings.
VITE_DRIVE_SCRIPT_URL=

# --- JANGAN diisi untuk deployment publik.
# --- vite.config.ts menanam nilai ini ke dalam bundle sisi klien, sehingga
# --- API key Gemini akan terbaca publik dan kuotanya bisa dipakai orang lain.
# --- Untuk mengaktifkan asisten AI dengan aman, panggil Gemini lewat
# --- serverless function agar key tetap berada di sisi server.
# GEMINI_API_KEY=
